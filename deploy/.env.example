# /opt/sssms/.env  (install.sh가 이 파일을 복사해 둡니다 — 값을 채운 뒤 서비스를 재시작하세요)

# 서버
PORT=3000
HOST=127.0.0.1            # Cloudflare Tunnel만 접속하므로 로컬호스트에만 바인딩
TZ=Asia/Seoul
SSSMS_DB=/opt/sssms/data/sssms.db

# 첫 실행 시 만들어지는 계정 비밀번호 (반드시 바꾸세요)
ADMIN_PASSWORD=change-me-admin
KIOSK_PASSWORD=change-me-kiosk
SEED_DEMO=0               # 0: 데모 학생·출석 기록을 만들지 않음

# 학교 구글 로그인 (Google Cloud Console → OAuth 클라이언트 ID, 승인된 JavaScript 원본에 https://<도메인> 추가)
GOOGLE_CLIENT_ID=
SCHOOL_DOMAIN=sunrint.hs.kr
# ALLOW_PASSWORD_LOGIN=1  # 구글 로그인과 학번·비밀번호 로그인을 같이 쓰려면
