# /opt/sssms/.env  (install.sh가 이 파일을 복사해 둡니다 — 값을 채운 뒤 서비스를 재시작하세요)
# 주의: systemd는 값 뒤에 붙은 # 주석을 값의 일부로 읽습니다. 주석은 항상 따로 한 줄에 쓰세요.

# 서버
PORT=3000
# Cloudflare Tunnel만 접속하므로 로컬호스트에만 바인딩
HOST=127.0.0.1
TZ=Asia/Seoul
SSSMS_DB=/opt/sssms/data/sssms.db

# 첫 실행 시 만들어지는 계정 비밀번호 (반드시 바꾸세요 — 아래 값 그대로면 외부에서 로그인할 수 없습니다)
# 첫 실행 뒤에는 관리자 → 설정, 또는 `node server/passwd.js <아이디>`로 바꿉니다
ADMIN_PASSWORD=change-me-admin
KIOSK_PASSWORD=change-me-kiosk

# 키오스크 계정을 쓸 수 있는 IP (쉼표로 구분, 203.0.113.0/24 형식도 가능). 학교 공인 IP를 넣으면
# 키오스크 비밀번호가 새도 학교 밖에서는 출석 처리를 할 수 없습니다. 비워 두면 제한 없음.
KIOSK_ALLOWED_IPS=
# 0: 데모 학생(비밀번호 1234)·출석 기록을 만들지 않음
SEED_DEMO=0

# 학교 구글 로그인 (Google Cloud Console → OAuth 클라이언트 ID, 승인된 JavaScript 원본에 https://<도메인> 추가)
GOOGLE_CLIENT_ID=
SCHOOL_DOMAIN=sunrint.hs.kr
# ALLOW_PASSWORD_LOGIN=1  # 구글 로그인과 학번·비밀번호 로그인을 같이 쓰려면
